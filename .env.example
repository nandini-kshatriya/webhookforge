# Copy this file to .env for local docker-compose development

# Database (docker-compose service name "postgres")
DATABASE_URL=postgresql+psycopg2://webhookforge:webhookforge@postgres:5432/webhookforge

# Redis / Celery broker (docker-compose service name "redis")
REDIS_URL=redis://redis:6379/0

# Shared-secret auth for write endpoints. The app REFUSES to start with the
# default value when ENV=production.
API_KEY=dev-local-api-key

# Browser origins allowed to call the API (comma-separated). "*" = any (dev only).
ALLOWED_ORIGINS=*

ENV=development

# Delivery tuning
DELIVERY_TIMEOUT_SECONDS=10
MAX_DELIVERY_ATTEMPTS=5
BACKOFF_BASE_SECONDS=30

# Local dev: leave both empty/unset. The Vite dev proxy forwards /api/* to
# http://localhost:8000 and the client falls back to the dev API key.
#
# Production (set these in Vercel -> Project -> Settings -> Environment Variables):
#   VITE_API_BASE=https://<your-service>.onrender.com     (no trailing slash)
#   VITE_API_KEY=<the same value as API_KEY on Render>
#
# NOTE: anything prefixed VITE_ is compiled into the public JavaScript bundle.
# VITE_API_KEY is therefore visible to anyone who opens dev tools.
VITE_API_BASE=
VITE_API_KEY=
